rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    // פרופילי משתמשים - כל משתמש מחובר יכול לקרוא (לצורך הצגת שותפים),
    // אך לכתוב רק לפרופיל של עצמו
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /weddings/{weddingId} {
      function data() {
        return resource.data;
      }
      function isMember() {
        return isSignedIn() && request.auth.uid in data().memberIds;
      }
      function isInvited() {
        return isSignedIn() && userEmail() in data().pendingInvites;
      }

      // קריאה: חברים או מוזמנים
      allow read: if isMember() || isInvited();

      // יצירה: המשתמש הוא הבעלים והחבר הראשון
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.memberIds;

      // עדכון: חברים קיימים, או מוזמן שמצרף את עצמו / דוחה הזמנה
      allow update: if isMember() || isInvited();

      // מחיקה: רק הבעלים
      allow delete: if isSignedIn() && request.auth.uid == data().ownerId;

      // תתי-אוספים: גישה לחברי החתונה בלבד
      match /{sub}/{docId} {
        function parentMembers() {
          return get(/databases/$(database)/documents/weddings/$(weddingId)).data.memberIds;
        }
        allow read, write: if isSignedIn() && request.auth.uid in parentMembers();
      }
    }
  }
}
