rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // קבצי החתונה (תמונות אולמות, השראה ומסמכים).
    // דרישת התחברות + הגבלת גודל וסוג קובץ.
    // הערה: הנתיבים ממופתחים לפי מזהה חתונה אקראי שאינו חשוף למי שאינו חבר,
    // ולכן זו הגנה סבירה. (אפשר להחמיר בהמשך לבדיקת חברוּת מלאה.)
    match /weddings/{weddingId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('application/pdf'));
      allow delete: if request.auth != null;
    }
  }
}
